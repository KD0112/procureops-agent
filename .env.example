# Local bootstrap. Point this at a private env file instead of copying secrets.
PROCUREOPS_ENV_FILE=D:\new things\项目1\day1\.env

PROCUREOPS_ENV=development
PROCUREOPS_DATABASE_URL=sqlite:///./var/procureops.sqlite3
PROCUREOPS_AUDIT_PATH=./var/audit.jsonl
PROCUREOPS_DEFAULT_TENANT=tenant_engineering_machinery
PROCUREOPS_TEXT_PROVIDER=deepseek
PROCUREOPS_MODEL=deepseek-chat
PROCUREOPS_MAX_MODEL_CALLS=8
PROCUREOPS_MAX_TOOL_CALLS=24
PROCUREOPS_MAX_TOKENS=32000

