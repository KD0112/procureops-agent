# Local bootstrap. Point this at a private env file instead of copying secrets.
PROCUREOPS_ENV_FILE=D:\new things\项目1\day1\.env

PROCUREOPS_ENV=development
PROCUREOPS_DATABASE_URL=sqlite:///./var/procureops.sqlite3
PROCUREOPS_AUDIT_PATH=./var/audit.jsonl
PROCUREOPS_DEFAULT_TENANT=tenant_engineering_machinery
AGENT_TEXT_PROVIDER=deepseek
AGENT_TEXT_ROUTE=qwen,deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 千问文本/视觉切换（密钥仍需从阿里云百炼控制台申请）
# AGENT_TEXT_PROVIDER=qwen
# AGENT_VISION_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_TEXT_MODEL=qwen-flash
# QWEN_VISION_MODEL=qwen-vl-plus

# 当前智谱视觉配置（切到千问后可保留为回退）
AGENT_VISION_PROVIDER=zhipu
AGENT_VISION_ROUTE=qwen,zhipu
# AGENT_VISION_BASE_URL=
# AGENT_VISION_MODEL=
# ZHIPU_API_KEY=
PROCUREOPS_MAX_MODEL_CALLS=8
PROCUREOPS_MAX_TOOL_CALLS=24
PROCUREOPS_MAX_TOKENS=32000
PROCUREOPS_ENABLE_LIVE_MODELS=0
