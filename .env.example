# Local API
PROCUREOPS_API_PORT=8030
PROCUREOPS_QUEUE_BACKEND=sqlite
PROCUREOPS_RAG_ANN_BACKEND=hnsw

# Enable after docker compose -f docker-compose.infra.yml up -d
PROCUREOPS_MYSQL_URL=mysql+asyncmy://procureops:procureops-local@127.0.0.1:3307/procureops
PROCUREOPS_REDIS_URL=redis://127.0.0.1:6380/0

# To route document ingestion to Redis Streams instead of SQLiteWorkQueue:
# PROCUREOPS_QUEUE_BACKEND=redis-streams

# MCP is optional and remains read-only:
# PROCUREOPS_INTEGRATION_PROFILE=mcp_sandbox

# Optional quality and observability profile. Disabled unless explicitly enabled.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=procureops-local
LANGFUSE_CAPTURE_IO=0
