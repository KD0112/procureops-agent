{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "procureops://tenant_engineering_machinery/product-schema/1.0.0",
  "title": "工程机械配件采购行",
  "type": "object",
  "additionalProperties": false,
  "required": ["line_id", "description", "quantity", "unit"],
  "properties": {
    "line_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "quantity": {"type": "number", "exclusiveMinimum": 0},
    "unit": {"type": "string", "minLength": 1},
    "part_number": {"type": ["string", "null"]},
    "equipment_brand": {"type": ["string", "null"]},
    "equipment_model": {"type": ["string", "null"]},
    "serial_number": {"type": ["string", "null"]},
    "required_by": {"type": ["string", "null"], "format": "date"},
    "allow_equivalent": {"type": "boolean", "default": false},
    "notes": {"type": ["string", "null"]}
  }
}
