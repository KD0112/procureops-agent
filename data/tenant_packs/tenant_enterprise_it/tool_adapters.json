{
  "adapter_pack_version": "2.0.0",
  "supported_profiles": ["local", "http_sandbox", "http_enterprise", "mcp_sandbox", "mcp_readonly"],
  "adapters": {
    "catalog_lookup": {
      "system": "erp",
      "local_adapter": "sqlite_catalog_v1",
      "http_contract": "erp.catalog.search.v1",
      "http_path": "/erp/v1/catalog/search"
    },
    "supplier_lookup": {
      "system": "supplier_network",
      "local_adapter": "sqlite_supplier_options_v1",
      "http_contract": "supplier.options.v1",
      "http_path": "/supplier/v1/options"
    },
    "logistics_quote": {
      "system": "logistics",
      "local_adapter": "sqlite_logistics_quotes_v1",
      "http_contract": "logistics.quotes.v1",
      "http_path": "/logistics/v1/quotes"
    },
    "purchase_order_draft": {
      "system": "erp",
      "local_adapter": "sqlite_po_draft_v1",
      "http_contract": "erp.purchase_order_draft.v1",
      "http_path": "/erp/v1/purchase-orders/drafts"
    }
  },
  "external_side_effects_default": "disabled"
}
