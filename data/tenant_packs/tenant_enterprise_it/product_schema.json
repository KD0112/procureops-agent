{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "procureops://tenant_enterprise_it/product-schema/1.0.0",
  "title": "企业 IT 设备采购行",
  "type": "object",
  "additionalProperties": false,
  "required": ["line_id", "description", "quantity", "unit"],
  "properties": {
    "line_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "quantity": {"type": "number", "exclusiveMinimum": 0},
    "unit": {"type": "string", "minLength": 1},
    "sku": {"type": ["string", "null"]},
    "asset_standard": {"type": ["string", "null"]},
    "cpu": {"type": ["string", "null"]},
    "memory_gb": {"type": ["integer", "null"], "minimum": 1},
    "storage_gb": {"type": ["integer", "null"], "minimum": 1},
    "warranty_years": {"type": ["integer", "null"], "minimum": 1},
    "required_by": {"type": ["string", "null"], "format": "date"},
    "allow_equivalent": {"type": "boolean", "default": false},
    "notes": {"type": ["string", "null"]}
  }
}
